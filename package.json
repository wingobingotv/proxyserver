{
  "name": "wingobingo-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Secure application-level relay between WingoBingo and selected third-party providers (payment gateways). Not an open proxy.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
