# wingobingo-proxy — copy to .env and fill in. Never commit .env.
# The service refuses to start on any missing or unsafe value and lists every
# problem at once (docker compose logs proxy). Secrets are never printed.
#
# Generate secrets with:   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
# Generate a data key with: openssl rand -hex 32

# ── Service ─────────────────────────────────────────────────────────────────
# production | staging | development | test  (http URLs are refused outside development/test)
APP_ENV=production
# Port inside the container.
PORT=8080
# Public https origin of this proxy (what Nginx serves), no path.
PUBLIC_BASE_URL=https://proxy.example.com
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Docker / Nginx (read by docker-compose.yml) ─────────────────────────────
# Host port Nginx proxies to. Bound to PROXY_BIND only.
PROXY_HOST_PORT=8080
PROXY_BIND=127.0.0.1
# Private subnet of the compose network. Pick one unused on this host.
PROXY_DOCKER_SUBNET=172.31.250.0/24
# Who may set X-Forwarded-For. Nginx on the host reaches the container from
# the compose network's gateway, so this is the subnet above.
TRUSTED_PROXIES=172.31.250.0/24

# ── Storage ─────────────────────────────────────────────────────────────────
# docker-compose.yml sets DATABASE_PATH=/data/proxy.db (named volume proxy-data).
# AES-256-GCM keys for stored callback payloads: id:<64 hex>, newest first.
# Rotate by putting a new key first and keeping the old one until
# CALLBACK_PAYLOAD_RETENTION_DAYS have passed.
DATA_ENCRYPTION_KEYS=k1:<64-hex-chars>
CALLBACK_PAYLOAD_RETENTION_DAYS=30

# ── Internal relay (Player API → proxy) ─────────────────────────────────────
# id:secret[:scopes], comma separated; scopes relay (default) and/or admin, joined with +.
# All listed keys are valid at once, so rotation is: add new, switch callers, remove old.
# The Player API uses one relay key (PAYMENT_PROXY_KEY_ID / PAYMENT_PROXY_SECRET).
INTERNAL_HMAC_KEYS=backend-1:<secret-32+>,admin-1:<secret-32+>:admin
# Public IP(s) of the Player API (and Admin API, for admin keys). Required in production.
INTERNAL_ALLOWED_IPS=203.0.113.10
INTERNAL_AUTH_MAX_SKEW_SECONDS=300
INTERNAL_MAX_BODY_BYTES=65536
INTERNAL_RATE_LIMIT_PER_MINUTE=1200
INTERNAL_AUTH_FAILURES_PER_MINUTE=30

# ── Main backend (proxy → Player API, callback delivery) ────────────────────
# Origin where the Player API serves /webhooks/… unchanged (no path rewriting in between).
MAIN_BACKEND_BASE_URL=https://api.example.com
# The proxy signs every forwarded callback; the Player API checks it with
# PAYMENT_PROXY_CALLBACK_KEYS=<this id>:<this secret>.
BACKEND_CALLBACK_SIGNING_KEY_ID=proxy-1
BACKEND_CALLBACK_SIGNING_SECRET=<secret-32+>
MAIN_BACKEND_ALLOW_PRIVATE_NETWORK=false
MAIN_BACKEND_CONNECT_TIMEOUT_MS=5000
CALLBACK_FORWARD_TIMEOUT_MS=10000
CALLBACK_MAX_ATTEMPTS=20
CALLBACK_RETRY_BASE_MS=5000
CALLBACK_RETRY_MAX_MS=900000
CALLBACK_WORKER_INTERVAL_MS=2000
CALLBACK_WORKER_BATCH_SIZE=20
CALLBACK_RATE_LIMIT_PER_IP_PER_MINUTE=300

# ── Metrics ─────────────────────────────────────────────────────────────────
# Bearer token for GET /metrics. Empty = /metrics answers 404.
METRICS_TOKEN=

# ── Provider: ParsCoin (Iranian card gateway "gw_a") ────────────────────────
PARSCOIN_ENABLED=false
# Origin only. The Player API's current value is in backend gatewayA.js (BASE_URL).
PARSCOIN_BASE_URL=https://provider-api.example
# Must contain the host of PARSCOIN_BASE_URL; nothing else is ever contacted.
PARSCOIN_ALLOWED_HOSTS=provider-api.example
# The merchant API token (sent as X-API-TOKEN) and merchant ID (signs webhooks).
# Same values as Admin Panel → Finance → Iranian payments → Settings.
PARSCOIN_API_TOKEN=
PARSCOIN_MERCHANT_ID=
# Public callback path is /callback/<slug>. A neutral slug keeps the provider's
# name out of URLs shown in the admin panel.
PARSCOIN_CALLBACK_SLUG=gw-a
# Player API webhook path the callback is delivered to.
PARSCOIN_CALLBACK_PATH=/webhooks/ir-card
# Optional: provider callback source IPs/CIDRs. Empty = any source (signature still required).
PARSCOIN_CALLBACK_ALLOWED_IPS=
# true = answer 202 once stored when the backend is down; false = 503 so the provider retries too.
PARSCOIN_CALLBACK_ACK_WHEN_QUEUED=true
PARSCOIN_CALLBACK_RATE_LIMIT_PER_MINUTE=600
PARSCOIN_TIMEOUT_MS=15000
PARSCOIN_CONNECT_TIMEOUT_MS=5000
# Total time for one call including retries. Keep it under the Player API's 20 s timeout.
PARSCOIN_DEADLINE_MS=18000
# Extra attempts for verify (create is never re-sent once it may have reached the provider).
PARSCOIN_VERIFY_RETRIES=2
PARSCOIN_MAX_RESPONSE_BYTES=1048576
PARSCOIN_ALLOW_PRIVATE_NETWORK=false
PARSCOIN_CIRCUIT_FAILURE_THRESHOLD=5
PARSCOIN_CIRCUIT_RESET_MS=30000
